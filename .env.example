# Database
DATABASE_URL=postgres://securitypulse:secret@postgres:5432/securitypulse

# Microsoft Graph (app registration, client credentials)
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-client-id
GRAPH_CLIENT_SECRET=your-client-secret

# Optional: Teams webhook for CRITICAL alerts
TEAMS_WEBHOOK_URL=

# API (for web app to call)
API_URL=http://api:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Entra ID for UI auth (MSAL)
NEXT_PUBLIC_ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
# Restrict dashboard to this security group object id
SECURITY_ADMIN_GROUP_ID=

# Node
NODE_ENV=development

# Optional: use mock Graph data (fixtures) instead of real tenant
USE_GRAPH_MOCK=false
